{
  "name": "vibe-rewards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && eslint . && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2",
    "canvas-confetti": "^1.9",
    "jsqr": "^1.4",
    "lucide-react": "^0.468",
    "qrcode": "^1.5",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@playwright/test": "^1.56",
    "@types/canvas-confetti": "^1.9",
    "@types/node": "^22.18",
    "@types/qrcode": "^1.5",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4.7",
    "autoprefixer": "^10.4",
    "eslint": "^9.39",
    "eslint-plugin-react-hooks": "^5.2",
    "postcss": "^8.5",
    "tailwindcss": "^3.4",
    "typescript": "~5.8",
    "typescript-eslint": "^8.46",
    "vite": "^6.4",
    "vite-plugin-pwa": "^1.0",
    "vitest": "^5.1.0"
  }
